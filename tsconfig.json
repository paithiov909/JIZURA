{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "ES2022.Intl"
    ],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true
  },
  "include": [
    "build/**/*.mts",
    "build/**/*.ts",
    "vite.config.mts",
    "dev/cep-offline-spike/*.ts",
    "engine/**/*.ts",
    "tests/engine/**/*.mts",
    "tests/engine/**/*.ts"
  ]
}
