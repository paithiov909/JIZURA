{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["build/**/*.mts", "build/**/*.ts", "vite.config.mts", "dev/cep-offline-spike/*.ts"]
}
