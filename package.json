{
  "name": "jizura",
  "private": true,
  "description": "JIZURA migration build workspace; application version comes from VERSION",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build/build.mts all",
    "build:web": "node build/build.mts web",
    "build:offline": "node build/build.mts offline",
    "build:ae": "node build/build.mts ae",
    "build:cep": "node build/build.mts cep",
    "check": "npm run typecheck && npm run check:i18n && npm run test:i18n && npm run test:engine && npm run test:effects && npm run build && npm run check:outputs && npm run check:effects && npm run test:ae",
    "check:outputs": "node build/check-outputs.mts",
    "test:ae": "node dev/ae_test.js --jsx dist/ae/JIZURA_AE.jsx tests/baseline/v1/lrc-ja-ae-plan.json && node dev/ae_test.js --jsx dist/ae/JIZURA_AE_en.jsx tests/baseline/v1/lrc-ja-ae-plan.json",
    "test:browser": "python3 dev/build_foundation_test.py",
    "spike:build": "node dev/cep-offline-spike/build.mjs",
    "spike:test": "node dev/cep-offline-spike/node-test.mjs",
    "spike:browser": "python3 dev/cep-offline-spike/browser_test.py",
    "test:engine": "node --test --test-isolation=none tests/engine/contract.mts",
    "test:engine:browser": "python3 dev/engine_modules_test.py",
    "test:effects": "node --test --test-isolation=none tests/effects/contract.mts",
    "check:effects": "node build/check-effects.mts --ae dist/ae/JIZURA_AE.jsx && node build/check-effects.mts --ae dist/ae/JIZURA_AE_en.jsx",
    "check:i18n": "node build/check-i18n.mts",
    "test:i18n": "node --test --test-isolation=none tests/i18n/contract.mts",
    "test:i18n:browser": "python3 dev/i18n_test.py",
    "test:i18n:source": "node dev/i18n_source_test.mjs",
    "test:editor:browser": "python3 dev/editor_test.py",
    "typecheck:remotion": "npm run typecheck --workspace remotion-jizura",
    "test:remotion": "npm run test --workspace remotion-jizura",
    "build:remotion": "npm run build --workspace remotion-jizura",
    "studio:remotion": "npm run studio --workspace remotion-jizura --",
    "still:remotion": "npm run still --workspace remotion-jizura --",
    "render:remotion": "npm run render --workspace remotion-jizura --",
    "check:remotion": "npm run check --workspace remotion-jizura",
    "player:remotion": "npm run player --workspace remotion-jizura --"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "acorn": "8.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "workspaces": [
    "remotion-jizura"
  ]
}
